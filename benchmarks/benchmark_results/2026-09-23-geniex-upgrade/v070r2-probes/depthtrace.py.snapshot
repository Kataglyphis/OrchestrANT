"""Does llama.cpp decode slow down with depth INSIDE one reply?

One long streamed reply, a timestamp per delta, the rate over each 256-token
window. Within one reply the machine state is continuous, so a falling rate
with token position is depth (the growing KV); a flat one means the r2 run's
slow long rows were order/heat. Run on a fresh, idle lane: a 30 s rest first,
then the long prompt first, then a spacer, then a second long prompt.
"""

import json
import sys
import time
import urllib.request

URL = "http://127.0.0.1:18184/v1/chat/completions"
MODEL = "unsloth/Qwen3-4B-GGUF:Q4_0"
PROMPTS = {
    "blog": (
        "Write a detailed technical blog post about the benefits and "
        "challenges of running large language models locally."
    ),
    "python": (
        "Write a Python function that computes the Fibonacci sequence using "
        "memoization, with docstrings and type hints."
    ),
}


def post(body):
    req = urllib.request.Request(
        URL, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"}
    )
    return urllib.request.urlopen(req, timeout=900)


def trace(prompt):
    body = {
        "model": MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 2048,
        "stream": True,
    }
    stamps = []
    t0 = time.monotonic()
    with post(body) as r:
        for raw in r:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                chunk = json.loads(data)
            except json.JSONDecodeError:
                continue
            for c in chunk.get("choices") or []:
                d = c.get("delta") or {}
                if d.get("content") or d.get("reasoning_content") or d.get("reasoning"):
                    stamps.append(time.monotonic() - t0)
    windows = []
    for start in range(1, len(stamps) - 1, 256):
        end = min(start + 256, len(stamps) - 1)
        if end - start < 64:
            break
        windows.append(
            {"tokens": f"{start}-{end}", "tok_per_s": round((end - start) / (stamps[end] - stamps[start]), 2)}
        )
    return {"tokens": len(stamps), "ttft_s": round(stamps[0], 3) if stamps else None, "windows": windows}


def spacer():
    with post({"model": MODEL, "messages": [{"role": "user", "content": "ok"}], "max_tokens": 1}) as r:
        r.read()


spacer()  # load
time.sleep(30)  # rest: no heat carried in
out = {}
for name in ("blog", "python"):
    out[name] = trace(PROMPTS[name])
    print(name, out[name]["tokens"], "tokens:", [w["tok_per_s"] for w in out[name]["windows"]], flush=True)
    spacer()
json.dump(out, open(sys.argv[1], "w", encoding="utf-8"), indent=1)
