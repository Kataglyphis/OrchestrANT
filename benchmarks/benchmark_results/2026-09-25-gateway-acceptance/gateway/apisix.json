     "max_retries": 1,
     "retry_on_failure_within_ms": 299000,
     "streaming_flush_interval_ms": 0,
     "timeout": 1800000
    },
    "geniex-shape": {
     "drop_fields": [
      "power_mode"
     ],
     "estimate": true,
     "lanes": {
      "gpu": {
       "overflow_relabel": false,
