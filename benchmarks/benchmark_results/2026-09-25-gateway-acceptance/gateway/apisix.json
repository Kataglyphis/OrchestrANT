{
 "consumers": [
  {
   "plugins": {
    "key-auth": {
     "key": "Bearer ${{GW_KEY_WEBUI}}"
    }
   },
   "username": "webui"
  },
  {
   "plugins": {
    "key-auth": {
     "key": "Bearer ${{GW_KEY_LAB}}"
    }
   },
   "username": "lab"
  },
  {
   "plugins": {
    "key-auth": {
     "key": "Bearer ${{GW_KEY_AGENT}}"
    }
   },
   "username": "agent"
  }
 ],
 "global_rules": [
  {
   "id": "observe",
   "plugins": {
    "file-logger": {
     "log_format": {
      "aborted": "$gw_stream_aborted",
      "alias": "$request_llm_model",
      "completion_tokens": "$llm_completion_tokens",
      "consumer": "$consumer_name",
      "est_tokens": "$gw_est",
      "lane": "$gw_lane",
      "method": "$request_method",
      "model": "$llm_model",
      "prompt": "$gw_prompt",
      "prompt_tokens": "$llm_prompt_tokens",
      "request_s": "$request_time",
      "rerouted": "$gw_rerouted",
      "status": "$status",
      "stream": "$llm_stream",
      "tool_calls": "$llm_has_tool_calls",
      "tools": "$llm_tool_count",
      "ts": "$time_iso8601",
      "ttft_ms": "$llm_time_to_first_token",
      "upstream": "$upstream_addr",
      "upstream_ms": "$apisix_upstream_response_time",
      "upstream_status": "$upstream_status",
      "uri": "$uri"
     },
     "path": "/var/log/gateway/requests.jsonl"
    },
    "prometheus": {
     "prefer_name": true
    }
   }
  }
 ],
 "plugin_metadata": [
  {
   "bytes_per_token": 3.0,
   "default_reserve": 1024,
   "id": "geniex-shape",
   "prompt_bytes": {
    "chat": 1823
   }
  }
 ],
 "routes": [
  {
   "id": "gateway-info",
   "methods": [
    "GET"
   ],
   "name": "gateway-info",
   "plugins": {
    "mocking": {
     "content_type": "application/json",
     "response_example": "{\"boot_config_sha256\":\"a5728681c93bd8fd7238d87fcd10a5c08d748e85bfa9f7d6cbb9f676e6a766b7\",\"config_sha256\":\"8975a754ebd6f883a4c65e1cbd27314915002c2fe88ebd01a21e22576aaba2d1\",\"image\":\"docker.io/apache/apisix:3.18.0-debian@sha256:84e6b5e787e9f889ebff88161cb9a16599bafcffa236c6b54c7f779a0655940d\",\"lua_sha256\":{\"apisix/plugins/geniex-shape.lua\":\"4f178da6323de76bd1bbea8e8637a07b1cc982b1ee1178a695ba8ec57a4e6119\",\"geniex_hook.lua\":\"566ead95a7fa97e9c0b5aba28b60f530174163337a8b44c2583992ce1fd00bef\"},\"prompts_sha256\":{\"tool-disambiguation\":\"970a8e4fcaf8540f55be6011c06ee33489e7915774ffc304d4022482b743e709\"},\"registry_sha256\":\"97a0798a37b789887b9c7b45ead7a4bfc2bfc6d3a9325e4e958ca98b4073b187\",\"restart_sha256\":\"bd9f04e416743af01f1d1a142ccf9f3b21aac032a0341dee1935e99d292547e0\"}",
     "response_status": 200,
     "with_mock_header": false
    }
   },
   "priority": 0,
   "uri": "/gateway/info"
  },
  {
   "id": "chat-presend",
   "methods": [
    "POST"
   ],
   "name": "chat-presend",
   "plugins": {
    "ai-proxy-multi": {
     "instances": [
      {
       "auth": {
        "header": {
         "Authorization": "Bearer unused"
        }
       },
       "name": "gpu",
       "options": {
        "model": "unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_0"
       },
       "override": {
        "endpoint": "http://127.0.0.1:18182"
       },
       "priority": 0,
       "provider": "openai-compatible",
       "weight": 1
      }
     ],
     "keepalive": false,
     "streaming_flush_interval_ms": 0,
     "timeout": 1800000
    },
    "geniex-shape": {
     "drop_fields": [
      "power_mode"
     ],
     "estimate": true,
     "lanes": {
      "gpu": {
       "overflow_relabel": false,
       "t0_rewrite": true,
       "timeout_ms": 1800000
      }
     },
     "primary": "gpu",
     "tag": "presend",
     "tools_prompt": {
      "b64": "",
      "name": "tool-disambiguation",
      "sha256": "970a8e4fcaf8540f55be6011c06ee33489e7915774ffc304d4022482b743e709"
     }
    },
    "key-auth": {
     "header": "Authorization",
     "hide_credentials": true
    }
   },
   "priority": 30,
   "uris": [
    "/v1/chat/completions",
    "/v1/completions"
   ],
   "vars": [
    [
     "post_arg.model",
     "==",
     "chat"
    ],
    [
     "gw_est_tokens",
     ">",
     3900
    ]
   ]
  },
  {
   "id": "chat",
   "methods": [
    "POST"
   ],
   "name": "chat",
   "plugins": {
    "ai-proxy-multi": {
     "fallback_strategy": [
      "http_5xx"
     ],
     "instances": [
      {
       "auth": {
        "header": {
         "Authorization": "Bearer unused"
        }
       },
       "name": "npu",
       "options": {
        "model": "qualcomm/Qwen3-4B-Instruct-2507:W4A16"
       },
       "override": {
        "endpoint": "http://127.0.0.1:18181"
       },
       "priority": 1,
       "provider": "openai-compatible",
       "weight": 1
