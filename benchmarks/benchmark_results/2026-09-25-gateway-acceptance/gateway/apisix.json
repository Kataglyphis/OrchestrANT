     "content_type": "application/json",
     "response_example": "{\"data\":[{\"created\":0,\"id\":\"chat\",\"object\":\"model\",\"owned_by\":\"llm-gateway\"},{\"created\":0,\"id\":\"chat-long\",\"object\":\"model\",\"owned_by\":\"llm-gateway\"},{\"created\":0,\"id\":\"agent\",\"object\":\"model\",\"owned_by\":\"llm-gateway\"}],\"object\":\"list\"}",
