# Shell scripts MUST be LF regardless of anyone's core.autocrlf. They run only
# inside the Linux CI container, and a lone CR from a Windows checkout makes
# bash read `\r` as part of a token - `set: pipefail\r: invalid option name`,
# or "$'\r': command not found" with exit 127 - which looks like a missing tool
# but is a line-ending fault. Git already stores these as LF; this makes the
# guarantee explicit so a Windows checkout cannot produce a CRLF working copy
# that fails locally while CI stays green.
*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# The tools system prompt, pinned byte for byte: P8.1 measured the CRLF copy
# (1823 bytes, sha256 970a8e4f...), and ANTfrastructure's gateway refuses to
# render unless the file's RAW bytes match that pin (backends.json
# serving.gateway.prompts). -text stores the CRLF bytes in the blob and checks
# them out unconverted everywhere -- Windows, WSL, CI, the sdist -- where
# `text` would hand an LF copy to every checkout but a Windows one.
# tests/unit/benchmark/test_serving_evidence.py holds the three shas equal.
benchmarks/prompts/tool-disambiguation.md -text

# exclude vendored trees from language analysis
third_party/** linguist-vendored
build/** linguist-vendored
