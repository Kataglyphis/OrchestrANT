# LF regardless of core.autocrlf: a CR from a Windows checkout breaks bash in the Linux container.
*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# -text keeps the CRLF bytes everywhere: the gateway's registry pins this file's raw sha256.
benchmarks/prompts/tool-disambiguation.md -text

# exclude vendored trees from language analysis
third_party/** linguist-vendored
build/** linguist-vendored
