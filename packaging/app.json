{
  "name": "OrchestrANT",
  "id": "orchestrant",
  "distribution": "OrchestrANT",
  "description": "Real-time YOLO object detection with system monitoring, and the OrchestrANT LLM benchmark tools",
  "publisher": "Jonas Heinle",
  "homepage": "https://github.com/Kataglyphis/OrchestrANT",
  "license_file": "LICENSE",
  "icon": "images/logo.png",
  "extras": ["app"],
  "chain_opencv": true,
  "scripts": ["yolo-monitor", "orchestrant-bench", "orchestrant-smoke"],
  "gui_script": "yolo-monitor",
  "data_env": "ORCHESTRANT_DATA_DIR",
  "data_dir": "share/orchestrant",
  "data": [
    { "from": "resources/models/deim_dfine_n_coco.onnx", "to": "share/orchestrant/models/deim_dfine_n_coco.onnx" },
    { "from": "resources/models/deim_dfine_n_coco.LICENSE", "to": "share/orchestrant/models/deim_dfine_n_coco.LICENSE" },
    { "from": "resources/models/deim_dfine_n_coco.NOTICE", "to": "share/orchestrant/models/deim_dfine_n_coco.NOTICE" }
  ],
  "self_test": ["yolo-monitor", "--self-test"],
  "gstreamer": {
    "tools": ["gst-launch-1.0"],
    "plugins": ["coreelements", "videoconvertscale", "videorate", "autodetect", "video4linux2"],
    "optional": ["libcamera"],
    "elements": ["autovideosrc", "v4l2src", "videoconvert", "videoscale", "videorate", "capsfilter", "fdsink"]
  },
  "msi_upgrade_code": "{B7345903-A839-44F0-9784-35FA77657D53}"
}
